    "legal_privacy_services_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App nutzt Google Firebase (Anmeldung, Datenbank, Dateispeicher) und Google Maps bzw. Apple Karten für die Kartenansicht. Wechselkurse kommen von frankfurter.app, dabei werden keine persönlichen Daten übertragen. Daten können dabei auch auf Servern außerhalb der EU verarbeitet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app uses Google Firebase (sign-in, database, file storage) and Google Maps or Apple Maps for the map view. Exchange rates come from frankfurter.app, and no personal data is transferred. Data may also be processed on servers outside the EU."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama Google Firebase (giriş, veritabanı, dosya depolama) ve harita görünümü için Google Maps veya Apple Haritalar kullanır. Döviz kurları frankfurter.app'ten alınır, bu sırada kişisel veri aktarılmaz. Veriler AB dışındaki sunucularda da işlenebilir."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم التطبيق Google Firebase (تسجيل الدخول، قاعدة البيانات، تخزين الملفات) وGoogle Maps أو خرائط Apple لعرض الخريطة. تأتي أسعار الصرف من frankfurter.app، ولا تُنقل أي بيانات شخصية في ذلك. قد تتم معالجة البيانات أيضًا على خوادم خارج الاتحاد الأوروبي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app usa Google Firebase (inicio de sesión, base de datos, almacenamiento de archivos) y Google Maps o Apple Mapas para el mapa. Los tipos de cambio vienen de frankfurter.app, sin transmitir datos personales. Los datos también pueden tratarse en servidores fuera de la UE."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app utilise Google Firebase (connexion, base de données, stockage de fichiers) et Google Maps ou Apple Plans pour l'affichage des cartes. Les taux de change proviennent de frankfurter.app, sans transmission de données personnelles. Les données peuvent aussi être traitées sur des serveurs situés hors de l'UE."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app usa Google Firebase (accesso, database, archiviazione file) e Google Maps o Mappe di Apple per la visualizzazione della mappa. I tassi di cambio provengono da frankfurter.app, senza trasmettere dati personali. I dati possono essere trattati anche su server al di fuori dell'UE."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja korzysta z Google Firebase (logowanie, baza danych, przechowywanie plików) oraz z Google Maps lub Apple Maps do wyświetlania mapy. Kursy walut pochodzą z frankfurter.app – nie są przy tym przesyłane żadne dane osobowe. Dane mogą być przetwarzane również na serwerach poza UE."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение использует Google Firebase (вход, база данных, хранилище файлов) и Google Maps или Apple Карты для отображения карты. Курсы валют предоставляет frankfurter.app, личные данные при этом не передаются. Данные могут обрабатываться в том числе на серверах за пределами ЕС."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосунок використовує Google Firebase (вхід, база даних, сховище файлів) і Google Maps або Apple Карти для показу карти. Курси валют надходять від frankfurter.app, при цьому особисті дані не передаються. Дані також можуть оброблятися на серверах за межами ЄС."
          }
        }
      }
    },
