    "legal_terms_scope_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Bedingungen gelten für die Nutzung der App Tableo, mit der man bei teilnehmenden Restaurants am Tisch, zur Abholung oder zur Lieferung bestellen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These terms apply to the use of the Tableo app, which lets you order from participating restaurants at the table, for pickup or for delivery."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu koşullar, katılımcı restoranlardan masada, gel al veya teslimat ile sipariş verilebilen Tableo uygulamasının kullanımı için geçerlidir."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسري هذه الشروط على استخدام تطبيق Tableo، الذي يتيح الطلب من المطاعم المشاركة على الطاولة أو للاستلام أو للتوصيل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas condiciones se aplican al uso de la app Tableo, con la que se puede pedir en los restaurantes participantes en la mesa, para recoger o a domicilio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les présentes conditions s'appliquent à l'utilisation de l'app Tableo, qui permet de commander dans les restaurants partenaires à table, à emporter ou en livraison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste condizioni valgono per l'uso dell'app Tableo, con cui si può ordinare dai ristoranti aderenti al tavolo, da asporto o a domicilio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niniejsze warunki dotyczą korzystania z aplikacji Tableo, w której można składać zamówienia w restauracjach partnerskich – przy stoliku, na wynos lub z dostawą."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти условия действуют при использовании приложения Tableo, через которое можно заказывать в ресторанах-партнёрах за столиком, навынос или с доставкой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці умови діють для користування застосунком Tableo, через який можна замовляти в ресторанах-учасниках за столиком, на самовивіз або з доставкою."
          }
        }
      }
    },
