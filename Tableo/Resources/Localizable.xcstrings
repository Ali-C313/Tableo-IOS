    "legal_terms_delivery_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angezeigte Ankunftszeiten sind Schätzungen. Für Verzögerungen durch Verkehr oder hohe Auslastung übernehmen wir keine Gewähr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displayed arrival times are estimates. We accept no liability for delays caused by traffic or high demand."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gösterilen varış süreleri tahminidir. Trafik veya yoğunluk nedeniyle oluşan gecikmeler için garanti vermiyoruz."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقات الوصول المعروضة تقديرية. لا نتحمّل أي مسؤولية عن التأخير بسبب حركة المرور أو كثرة الطلبات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las horas de llegada mostradas son estimaciones. No nos hacemos responsables de retrasos por el tráfico o por mucha demanda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les heures d'arrivée affichées sont des estimations. Nous ne garantissons rien en cas de retard dû à la circulation ou à une forte affluence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli orari di arrivo indicati sono stime. Non garantiamo per ritardi dovuti al traffico o a un carico di lavoro elevato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlane godziny dostawy są szacunkowe. Nie odpowiadamy za opóźnienia spowodowane ruchem drogowym lub dużym obciążeniem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Указанное время прибытия является ориентировочным. Мы не несём ответственности за задержки из-за пробок или высокой загрузки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вказаний час прибуття є орієнтовним. Ми не несемо відповідальності за затримки через дорожній рух або високе навантаження."
          }
        }
      }
    },
    "legal_terms_final_heading" : {
      "extractionState" : "manual",
      "localizations" : {
