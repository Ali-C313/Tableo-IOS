    "legal_privacy_staff_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Mitarbeiter speichern wir zusätzlich Restaurant, Rolle, Beitrittsdatum und ob sie gerade im Dienst sind. Diese Angaben sieht das Team des jeweiligen Restaurants."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For staff, we also store the restaurant, role, join date and whether they're currently on duty. This information is visible to the team of the respective restaurant."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışanlar için ayrıca restoranı, rolü, katılım tarihini ve şu an görevde olup olmadıklarını saklıyoruz. Bu bilgileri ilgili restoranın ekibi görür."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للموظفين نحفظ أيضًا المطعم والدور وتاريخ الانضمام وما إذا كانوا في الخدمة حاليًا. يرى هذه البيانات فريق المطعم المعني."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De los empleados guardamos además el restaurante, el rol, la fecha de incorporación y si están de servicio en ese momento. Estos datos los ve el equipo del restaurante correspondiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les employés, nous enregistrons en plus le restaurant, le rôle, la date d'arrivée et s'ils sont en service. Ces informations sont visibles par l'équipe du restaurant concerné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i dipendenti salviamo inoltre ristorante, ruolo, data di ingresso e se sono in servizio. Queste informazioni sono visibili al team del rispettivo ristorante."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku pracowników przechowujemy dodatkowo restaurację, rolę, datę dołączenia oraz informację, czy są akurat na zmianie. Te dane widzi zespół danej restauracji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "О сотрудниках мы дополнительно храним ресторан, роль, дату присоединения и находятся ли они сейчас на смене. Эти данные видит команда соответствующего ресторана."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для працівників ми додатково зберігаємо ресторан, роль, дату приєднання та те, чи вони зараз на зміні. Ці дані бачить команда відповідного ресторану."
          }
        }
      }
    },
    "legal_terms_account_heading" : {
      "extractionState" : "manual",
      "localizations" : {
