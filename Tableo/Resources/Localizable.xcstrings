    "legal_imprint_note_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableo ist ein Abschlussprojekt am Syntax Institut. Bestellungen und Zahlungen in der App sind nicht verbindlich, es wird kein echtes Geld abgebucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableo is a final project at Syntax Institut. Orders and payments in the app are not binding, and no real money is charged."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableo, Syntax Institut'ta yapılmış bir bitirme projesidir. Uygulamadaki siparişler ve ödemeler bağlayıcı değildir, gerçek para çekilmez."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableo مشروع تخرّج في Syntax Institut. الطلبات والمدفوعات في التطبيق غير ملزمة، ولا يتم خصم أي أموال حقيقية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableo es un proyecto final del Syntax Institut. Los pedidos y pagos en la app no son vinculantes y no se cobra dinero real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableo est un projet de fin de formation au Syntax Institut. Les commandes et paiements dans l'app ne sont pas contractuels, aucun argent réel n'est débité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableo è un progetto finale realizzato presso il Syntax Institut. Ordini e pagamenti nell'app non sono vincolanti e non viene addebitato denaro reale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableo to projekt dyplomowy w Syntax Institut. Zamówienia i płatności w aplikacji nie są wiążące, żadne prawdziwe pieniądze nie są pobierane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableo – выпускной проект в Syntax Institut. Заказы и платежи в приложении не являются обязательными, реальные деньги не списываются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableo – це випускний проєкт у Syntax Institut. Замовлення та оплати в застосунку не є обов'язковими, справжні гроші не списуються."
          }
        }
      }
    },
