    "legal_privacy_notifications_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigungen zu deinen Bestellungen erzeugt die App selbst auf dem Gerät. Es werden dafür keine Daten an einen Push-Dienst geschickt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications about your orders are created by the app itself on your device. No data is sent to a push service for this."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siparişlerinle ilgili bildirimleri uygulama doğrudan cihazda oluşturur. Bunun için hiçbir veri bir push servisine gönderilmez."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ التطبيق إشعارات طلباتك بنفسه على الجهاز. لا تُرسل لذلك أي بيانات إلى خدمة إشعارات فورية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La propia app genera en el dispositivo las notificaciones sobre tus pedidos. Para ello no se envía ningún dato a un servicio push."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sur tes commandes sont générées par l'app directement sur l'appareil. Aucune donnée n'est envoyée à un service de push."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche sui tuoi ordini vengono create dall'app direttamente sul dispositivo. Per questo non viene inviato alcun dato a un servizio push."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienia o twoich zamówieniach aplikacja tworzy sama na urządzeniu. Żadne dane nie są w tym celu wysyłane do usługi push."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления о заказах приложение создаёт само на устройстве. Данные для этого никакому push-сервису не отправляются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщення про твої замовлення застосунок створює сам на пристрої. Для цього жодні дані не надсилаються в push-сервіс."
          }
        }
      }
    },
    "legal_privacy_rights_heading" : {
      "extractionState" : "manual",
      "localizations" : {
