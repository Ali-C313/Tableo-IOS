    "legal_terms_account_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugangsdaten sind geheim zu halten. Mitarbeiter-Zugänge dürfen nur für das eigene Restaurant genutzt werden. Konten, die gegen diese Bedingungen verstoßen, können gesperrt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Login details must be kept confidential. Staff accounts may only be used for your own restaurant. Accounts that violate these terms may be suspended."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş bilgileri gizli tutulmalıdır. Çalışan hesapları yalnızca kendi restoranı için kullanılabilir. Bu koşulları ihlal eden hesaplar engellenebilir."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب الحفاظ على سرية بيانات الدخول. لا يجوز استخدام حسابات الموظفين إلا للمطعم الخاص بهم. يمكن حظر الحسابات التي تخالف هذه الشروط."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de acceso deben mantenerse en secreto. Las cuentas de empleado solo pueden usarse para el propio restaurante. Las cuentas que incumplan estas condiciones pueden ser bloqueadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identifiants doivent rester confidentiels. Les accès employés ne peuvent être utilisés que pour son propre restaurant. Les comptes qui enfreignent ces conditions peuvent être bloqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati di accesso devono restare riservati. Gli accessi dei dipendenti possono essere usati solo per il proprio ristorante. Gli account che violano queste condizioni possono essere bloccati."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane logowania należy zachować w tajemnicy. Konta pracowników mogą być używane wyłącznie dla własnej restauracji. Konta naruszające te warunki mogą zostać zablokowane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные для входа нужно держать в секрете. Доступ сотрудника можно использовать только для своего ресторана. Аккаунты, нарушающие эти условия, могут быть заблокированы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані для входу потрібно зберігати в таємниці. Доступи працівників можна використовувати лише для власного ресторану. Акаунти, що порушують ці умови, можуть бути заблоковані."
          }
        }
      }
    },
    "legal_terms_delivery_heading" : {
      "extractionState" : "manual",
      "localizations" : {
