    "Bekommst du von deinem Chef, steht im Personalbereich unter Team" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You get it from your manager. It's in the staff area under Team"
