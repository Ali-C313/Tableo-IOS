    "legal_imprint_dispute_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We are neither willing nor obliged to take part in dispute resolution proceedings before a consumer arbitration board."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir tüketici hakem kurulu önündeki uyuşmazlık çözüm süreçlerine katılmaya istekli değiliz ve bununla yükümlü değiliz."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لسنا مستعدين ولا ملزمين بالمشاركة في إجراءات تسوية النزاعات أمام هيئة تحكيم المستهلكين."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No estamos dispuestos ni obligados a participar en procedimientos de resolución de conflictos ante una entidad de arbitraje de consumo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne sommes ni disposés ni tenus à participer à une procédure de règlement des litiges devant un organisme de médiation de la consommation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non siamo disposti né obbligati a partecipare a procedure di risoluzione delle controversie davanti a un organismo di conciliazione per i consumatori."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie jesteśmy gotowi ani zobowiązani do udziału w postępowaniu w sprawie rozstrzygania sporów przed konsumenckim organem arbitrażowym."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы не готовы и не обязаны участвовать в процедурах урегулирования споров в потребительской арбитражной комиссии."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми не готові й не зобов'язані брати участь у процедурах вирішення спорів у споживчому арбітражному органі."
          }
        }
      }
    },
