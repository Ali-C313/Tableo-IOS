    "legal_privacy_controller_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verantwortlich für die Datenverarbeitung ist die im Impressum genannte Person."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person named in the legal notice is responsible for data processing."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veri işlemeden künyede adı geçen kişi sorumludur."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسؤول عن معالجة البيانات هو الشخص المذكور في بيانات الناشر."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La persona responsable del tratamiento de datos es la indicada en el aviso legal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le responsable du traitement des données est la personne indiquée dans les mentions légales."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il titolare del trattamento dei dati è la persona indicata nelle note legali."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratorem danych jest osoba wskazana w nocie prawnej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За обработку данных отвечает лицо, указанное в выходных данных."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відповідальною за обробку даних є особа, зазначена у вихідних даних."
          }
        }
      }
    },
    "legal_privacy_data_heading" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche Daten wir speichern"
          }
        },
        "en" : {
          "stringUnit" : {
