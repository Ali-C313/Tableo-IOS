    "legal_terms_final_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gilt deutsches Recht. Sollte eine Bestimmung unwirksam sein, bleiben die übrigen wirksam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "German law applies. If any provision is invalid, the remaining provisions remain in effect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alman hukuku geçerlidir. Bir hüküm geçersiz olursa diğerleri geçerliliğini korur."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسري القانون الألماني. إذا كان أحد البنود غير صالح، تبقى البنود الأخرى سارية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica el derecho alemán. Si alguna disposición no fuera válida, las demás seguirán siendo válidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le droit allemand s'applique. Si une disposition est invalide, les autres restent valables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica il diritto tedesco. Se una disposizione dovesse risultare non valida, le restanti restano valide."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obowiązuje prawo niemieckie. Jeśli którekolwiek postanowienie okaże się nieważne, pozostałe pozostają w mocy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется право Германии. Если какое-либо положение окажется недействительным, остальные сохраняют силу."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосовується право Німеччини. Якщо якесь положення виявиться недійсним, решта залишаються чинними."
          }
        }
      }
    },
    "legal_terms_liability_heading" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
