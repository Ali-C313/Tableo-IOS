    "Sobald ein Fahrer deine Bestellung hat, siehst du ihn hier live auf der Karte." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As soon as a driver picks up your order, you'll see them live on the map here."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kurye siparişini aldığında onu burada haritada canlı görürsün."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بمجرد أن يستلم سائق طلبك، ستراه هنا مباشرة على الخريطة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cuanto un repartidor tenga tu pedido, lo verás aquí en directo en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès qu'un livreur prend ta commande, tu le vois ici en direct sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appena un rider prende il tuo ordine, lo vedrai qui sulla mappa in tempo reale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy kierowca odbierze twoje zamówienie, zobaczysz go tutaj na mapie na żywo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как только курьер возьмёт твой заказ, ты увидишь его здесь на карте."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щойно кур'єр візьме твоє замовлення, ти побачиш його тут на карті наживо."
          }
        }
      }
    },
