    "legal_privacy_device_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Handy speichern wir nur Einstellungen wie Erscheinungsbild, Sprache und ob das Onboarding schon gezeigt wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your phone, we only store settings like appearance, language and whether the onboarding has already been shown."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonda sadece görünüm, dil ve tanıtımın gösterilip gösterilmediği gibi ayarları saklıyoruz."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على الهاتف نحفظ فقط الإعدادات مثل المظهر واللغة وما إذا كانت شاشات التعريف قد عُرضت."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el móvil solo guardamos ajustes como la apariencia, el idioma y si ya se ha mostrado la introducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur le téléphone, nous enregistrons uniquement des paramètres comme l'apparence, la langue et si l'onboarding a déjà été affiché."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul telefono salviamo solo impostazioni come aspetto, lingua e se l'onboarding è già stato mostrato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na telefonie zapisujemy tylko ustawienia, takie jak wygląd, język i to, czy wprowadzenie zostało już pokazane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На телефоне мы храним только настройки: оформление, язык и было ли уже показано приветствие."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На телефоні ми зберігаємо лише налаштування, як-от вигляд, мову і те, чи вже показувався онбординг."
          }
        }
      }
    },
    "legal_privacy_location_heading" : {
      "extractionState" : "manual",
