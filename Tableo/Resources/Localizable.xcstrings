    "legal_terms_parties_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestellungen gehen direkt an das jeweilige Restaurant. Tableo vermittelt nur die Bestellung und ist nicht Verkäufer der Speisen und Getränke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orders go directly to the respective restaurant. Tableo only facilitates the order and is not the seller of the food and drinks."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siparişler doğrudan ilgili restorana iletilir. Tableo yalnızca siparişe aracılık eder, yiyecek ve içeceklerin satıcısı değildir."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذهب الطلبات مباشرة إلى المطعم المعني. يقتصر دور Tableo على الوساطة في الطلب، وليس بائعًا للأطعمة والمشروبات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pedidos van directamente al restaurante correspondiente. Tableo solo gestiona el pedido y no es el vendedor de la comida ni de las bebidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commandes sont transmises directement au restaurant concerné. Tableo sert uniquement d'intermédiaire et ne vend ni les plats ni les boissons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli ordini vanno direttamente al rispettivo ristorante. Tableo fa solo da intermediario e non è il venditore di cibi e bevande."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamówienia trafiają bezpośrednio do danej restauracji. Tableo jedynie pośredniczy w zamówieniu i nie jest sprzedawcą potraw ani napojów."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заказы поступают напрямую в соответствующий ресторан. Tableo лишь передаёт заказ и не является продавцом блюд и напитков."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замовлення надходять безпосередньо до відповідного ресторану. Tableo лише передає замовлення і не є продавцем страв і напоїв."
          }
        }
      }
    },
    "legal_terms_prices_heading" : {
      "extractionState" : "manual",
      "localizations" : {
