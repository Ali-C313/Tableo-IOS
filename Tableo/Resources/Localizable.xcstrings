            "value" : "Ordine"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamówienie"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заказ"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замовлення"
          }
        }
      }
    },
    "legal_terms_order_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Absenden gibt der Kunde ein Angebot an das Restaurant ab. Das Restaurant kann die Bestellung annehmen oder stornieren, solange sie noch nicht unterwegs ist. Der Kunde kann stornieren, solange das Restaurant sie noch nicht angenommen hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By placing an order, the customer makes an offer to the restaurant. The restaurant can accept or cancel the order as long as it isn't on its way yet. The customer can cancel as long as the restaurant hasn't accepted it yet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müşteri, siparişi göndererek restorana bir teklif sunar. Restoran, sipariş henüz yola çıkmadığı sürece siparişi kabul edebilir veya iptal edebilir. Müşteri, restoran siparişi henüz kabul etmediği sürece iptal edebilir."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بإرسال الطلب يقدّم العميل عرضًا للمطعم. يمكن للمطعم قبول الطلب أو إلغاؤه ما دام لم يخرج للتوصيل بعد. ويمكن للعميل الإلغاء ما دام المطعم لم يقبله بعد."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al enviar el pedido, el cliente hace una oferta al restaurante. El restaurante puede aceptar o cancelar el pedido mientras no esté en camino. El cliente puede cancelarlo mientras el restaurante aún no lo haya aceptado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En envoyant sa commande, le client fait une offre au restaurant. Le restaurant peut accepter ou annuler la commande tant qu'elle n'est pas en route. Le client peut annuler tant que le restaurant ne l'a pas acceptée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con l'invio il cliente fa un'offerta al ristorante. Il ristorante può accettare o annullare l'ordine finché non è in consegna. Il cliente può annullarlo finché il ristorante non l'ha ancora accettato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłając zamówienie, klient składa restauracji ofertę. Restauracja może przyjąć zamówienie lub je anulować, dopóki nie jest ono w drodze. Klient może anulować zamówienie, dopóki restauracja go nie przyjęła."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляя заказ, клиент делает ресторану предложение. Ресторан может принять или отменить заказ, пока он ещё не в пути. Клиент может отменить заказ, пока ресторан его ещё не принял."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилаючи замовлення, клієнт робить ресторану пропозицію. Ресторан може прийняти або скасувати замовлення, поки воно ще не в дорозі. Клієнт може скасувати замовлення, поки ресторан його ще не прийняв."
          }
        }
      }
    },
    "legal_terms_parties_heading" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertragspartner"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contracting parties"
