          }
        }
      }
    },
    "legal_terms_liability_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Inhalt und Qualität der Speisen ist das jeweilige Restaurant verantwortlich. Tableo haftet nur bei Vorsatz und grober Fahrlässigkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The respective restaurant is responsible for the content and quality of the food. Tableo is only liable in cases of intent and gross negligence."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yemeklerin içeriği ve kalitesinden ilgili restoran sorumludur. Tableo yalnızca kast ve ağır ihmal durumunda sorumludur."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المطعم المعني مسؤول عن محتوى الأطعمة وجودتها. لا يتحمّل Tableo المسؤولية إلا في حالات العمد والإهمال الجسيم."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El restaurante correspondiente es responsable del contenido y la calidad de la comida. Tableo solo responde en caso de dolo o negligencia grave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le restaurant concerné est responsable du contenu et de la qualité des plats. Tableo n'est responsable qu'en cas de faute intentionnelle ou de négligence grave."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ristorante è responsabile del contenuto e della qualità dei cibi. Tableo risponde solo in caso di dolo o colpa grave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za skład i jakość potraw odpowiada dana restauracja. Tableo ponosi odpowiedzialność wyłącznie w przypadku winy umyślnej i rażącego niedbalstwa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За состав и качество блюд отвечает соответствующий ресторан. Tableo несёт ответственность только в случае умысла или грубой неосторожности."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За склад і якість страв відповідає відповідний ресторан. Tableo несе відповідальність лише за умисел і грубу необережність."
          }
        }
      }
    },
    "legal_terms_order_heading" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestellung"
          }
        },
        "en" : {
